<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_auto_interim" model="ir.ui.view">
        <field name="name">stock.picking.form.auto.interim</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_auto_interim_entry"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        invisible="not auto_interim_move_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Interim Entry</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
