<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Smart button: LC Allocation Entry -->
    <record id="view_stock_landed_cost_form_inherit_auto_interim" model="ir.ui.view">
        <field name="name">stock.landed.cost.form.auto_interim</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
        <field name="arch" type="xml">
            <!-- No button_box in base view — inject one before the title -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div name="button_box" class="oe_button_box">
                    <button
                        name="action_view_lc_interim_entry"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="not auto_interim_move_id"
                    >
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">LC Allocation</span>
                            <span class="o_stat_text">Entry</span>
                        </div>
                    </button>
                    <button
                        name="action_view_lc_cogs_entry"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="not auto_cogs_move_id"
                    >
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">LC COGS</span>
                            <span class="o_stat_text">Entry</span>
                        </div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
